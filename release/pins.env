# Pinned browser-examples model. The static examples site ships no model: it
# resolves seeded vectors from its bucket cache and streams this quantization
# from the CDN only to compute a genuine cache miss. The seeded vectors were
# produced by this exact file, so its digest is what keeps the deployed site in
# one vector space.
EXAMPLES_MODEL_FILE="embeddinggemma-300M-Q4_K_M.gguf"
EXAMPLES_MODEL_SHA256="676216d6d8abbd717688905a77230a213f9db095793ee8c1afb1aa5bf11eb531"
